{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakingrl.dev/schemas/marketplace/sections.schema.json",
  "title": "BakingRL Marketplace Sections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sections"],
  "properties": {
    "schema": { "const": "bakingrl.marketplace-sections/2" },
    "sections": { "$ref": "#/$defs/sections" }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "packageIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packageId" }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "new", "firstRun"],
      "properties": {
        "recommended": { "$ref": "#/$defs/packageIds" },
        "new": { "$ref": "#/$defs/packageIds" },
        "firstRun": { "$ref": "#/$defs/packageIds" }
      }
    }
  }
}
