{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BakingRL Marketplace Package",
  "type": "object",
  "required": ["schema", "id", "developerId", "repo", "listingUrl", "approvedVersions"],
  "properties": {
    "schema": { "const": "bakingrl.marketplace-package/1" },
    "id": { "type": "string" },
    "developerId": { "type": "string" },
    "repo": { "type": "string" },
    "listingUrl": { "type": "string" },
    "approvedVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "bundleUrl", "bundleSha256", "signaturePublicKey", "review"],
        "properties": {
          "version": { "type": "string" },
          "bundleUrl": { "type": "string" },
          "bundleSha256": { "type": "string" },
          "signaturePublicKey": { "type": "string" },
          "runtimeApi": { "type": ["string", "null"] },
          "revoked": { "type": "boolean" },
          "review": {
            "type": "object",
            "required": ["status", "reviewedAt", "permissions"],
            "properties": {
              "status": { "enum": ["approved", "rejected"] },
              "reviewedAt": { "type": "string" },
              "permissions": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
